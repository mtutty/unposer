#!/usr/bin/env bash
#
# Pulls the latest gforge-crm images and restarts any services whose image
# changed (services with no change are left running).
#
# Usage: ./update-crm

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/crm-common.sh"

echo "### Pulling latest images ..."
"${COMPOSE[@]}" pull

echo "### Recreating services with updated images ..."
"${COMPOSE[@]}" up -d --remove-orphans

echo "### Pruning dangling images ..."
docker image prune -f

echo
"${COMPOSE[@]}" ps

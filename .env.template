# Copy this file to .env and fill in real values. .env is gitignored —
# never commit the filled-in file.
#
#   Local dev:   cp .env.template .env        (docker-compose.yml + override)
#   Production:  cp .env.template /root/unposer/.env   (see infra/README.md)

# "development" enables non-secure cookies and is the default everywhere
# below; set to "production" on the real deployment — it's what flips the
# session cookie's Secure flag on (backend/src/routes/auth.routes.ts).
NODE_ENV=development

# Database (PostgreSQL) — docker-compose builds DATABASE_URL from these.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here

# Embeddings for candidate-evidence semantic search (profile_evidence/conversation_evidence) —
# always OpenAI regardless of LLM_PROVIDER above (Anthropic has no embeddings API). Leave unset
# to fall back to LLM_API_KEY, but only when LLM_PROVIDER=openai — set this explicitly if
# LLM_PROVIDER=anthropic. See backend/src/ai/embeddings.ts.
EMBEDDINGS_API_KEY=

# Session — generate with `openssl rand -hex 32` for production.
SESSION_SECRET=generate-a-random-string-here

# Dev Auth — devuser/devpass login bypass. Fine for local dev; MUST be
# false on any deployment reachable from the internet.
DEV_AUTH_ENABLED=true
DEV_AUTH_USERNAME=devuser
DEV_AUTH_PASSWORD=devpass

# Second dev-bypass identity, mapped to a role='admin' user — lets local dev
# reach admin-only screens without real OIDC. See config/index.ts devAuth.
DEV_AUTH_ADMIN_USERNAME=devadmin
DEV_AUTH_ADMIN_PASSWORD=devadminpass

# Invitation-only mode — when true, OIDC self-registration is blocked for anyone without an
# existing users row; only an admin-created invite (Users page > Invite) can become an account.
# Doesn't affect dev-login or the admin invite/revoke endpoints, which always work. Turn this on
# before opening the production instance up beyond yourself. See config/index.ts inviteOnly.
INVITE_ONLY_MODE=false

# OIDC Providers. Google and GitHub are both fully wired up
# (backend/src/routes/auth.routes.ts + services/auth.service.ts) — leave a pair blank to keep
# that one off (dev-login bypass always stays available regardless). The corresponding
# "Continue with ..." button on the login page only appears once its CLIENT_ID is set. LinkedIn
# is still not implemented — see CLAUDE.md Known TODOs.
#
# Each provider needs this exact callback URL registered on its side (derived from FRONTEND_URL,
# not a separate setting — see auth.service.ts's googleRedirectUri()/githubRedirectUri()):
#   production: https://unposer.com/api/auth/<google|github>/callback
#   local dev:  http://localhost:4200/api/auth/<google|github>/callback
# Google: register under "Authorized redirect URIs" in Google Cloud Console.
# GitHub: register as the single "Authorization callback URL" in the GitHub OAuth App settings
# (Settings > Developer settings > OAuth Apps) — GitHub only allows one per app, so local dev and
# production need two separate OAuth Apps (two separate client id/secret pairs) if you want both.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GITHUB_CLIENT_ID=
OIDC_GITHUB_CLIENT_SECRET=

# Real email gateway (Resend — both inbound and outbound for the Step 3 email channel). Leave
# RESEND_API_KEY/RESEND_WEBHOOK_SECRET unset to keep the channel simulated in-app only, same as
# before this was wired up — see backend/src/services/email.service.ts and
# backend/src/routes/webhooks.routes.ts, and infra/README.md for the one-time Resend setup
# (inbound MX record, webhook creation) this depends on.
RESEND_API_KEY=
# Signing secret Resend gives you when you create the email.received webhook (starts whsec_).
RESEND_WEBHOOK_SECRET=
# Inbound subdomain your Resend MX record points at, e.g. reply.unposer.com — NOT the same as
# DOMAIN_NAME above (keep candidate replies on a dedicated subdomain).
EMAIL_INBOUND_DOMAIN=
EMAIL_FROM_ADDRESS=Unposer <onboarding@resend.dev>

# Weekly re-engagement scheduler (spec §3.5) — backend/src/services/weekly-scheduler.cron.ts.
# Off by default, deliberately separate from the RESEND_* keys above: this job emails real
# candidates on a timer with no human in the loop, so it needs its own explicit opt-in even on a
# stack that already has real Resend credentials configured for webhook testing. Only turn this on
# where RESEND_API_KEY/RESEND_WEBHOOK_SECRET are also real and you mean for candidates to actually
# receive weekly prompts.
SCHEDULER_ENABLED=false
# node-cron 5-field syntax (no seconds). Default: every Monday 09:00 server time.
SCHEDULER_CRON=0 9 * * 1

# -----------------------------------------------------------------------------
# Production-only — used by docker-compose.production.yml and
# infra/init-letsencrypt.sh. Leave unset for local dev (docker-compose.yml +
# docker-compose.override.yml doesn't read these).
# -----------------------------------------------------------------------------

# Public hostname nginx requests a Let's Encrypt cert for and terminates TLS
# on. Production: unposer.com
DOMAIN_NAME=unposer.com

# Email Let's Encrypt uses for expiry notices / urgent renewal problems.
CERTBOT_EMAIL=you@example.com

# CORS origin the API accepts; also the origin the app assumes it's served
# from. Should match https://${DOMAIN_NAME} above.
FRONTEND_URL=https://unposer.com

# Copy this file to .env and fill in real values. .env is gitignored —
# never commit the filled-in file.
#
#   Local dev:   cp .env.template .env        (docker-compose.yml + override)
#   Production:  cp .env.template /root/unposer/.env   (see infra/README.md)

# "development" enables non-secure cookies and is the default everywhere
# below; set to "production" on the real deployment — it's what flips the
# session cookie's Secure flag on (backend/src/routes/auth.routes.ts).
NODE_ENV=development

# Database (PostgreSQL) — docker-compose builds DATABASE_URL from these.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here

# Session — generate with `openssl rand -hex 32` for production.
SESSION_SECRET=generate-a-random-string-here

# Dev Auth — devuser/devpass login bypass. Fine for local dev; MUST be
# false on any deployment reachable from the internet.
DEV_AUTH_ENABLED=true
DEV_AUTH_USERNAME=devuser
DEV_AUTH_PASSWORD=devpass

# OIDC Providers (optional — not yet wired up, see CLAUDE.md Known TODOs)
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GITHUB_CLIENT_ID=
OIDC_GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Production-only — used by docker-compose.production.yml and
# infra/init-letsencrypt.sh. Leave unset for local dev (docker-compose.yml +
# docker-compose.override.yml doesn't read these).
# -----------------------------------------------------------------------------

# Public hostname nginx requests a Let's Encrypt cert for and terminates TLS
# on. Production: unposer.com
DOMAIN_NAME=unposer.com

# Email Let's Encrypt uses for expiry notices / urgent renewal problems.
CERTBOT_EMAIL=you@example.com

# CORS origin the API accepts; also the origin the app assumes it's served
# from. Should match https://${DOMAIN_NAME} above.
FRONTEND_URL=https://unposer.com
